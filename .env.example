# Copia este archivo como .env y reemplaza cada valor replace-with-*.
# El archivo .env nunca se sube al repositorio.

# --- API ---
API_PORT=8080
API_ENV=dev
# Dentro de Docker Compose se usa el nombre del servicio (postgres), no localhost.
DATABASE_URL=postgres://usuarios_roles:replace-with-contrasena-postgres@postgres:5432/usuarios_roles?sslmode=disable
FRONTEND_URL=http://localhost:5160
TZ=America/Santiago

# --- PostgreSQL (solo para Docker Compose) ---
POSTGRES_USER=usuarios_roles
POSTGRES_PASSWORD=replace-with-contrasena-postgres
POSTGRES_DB=usuarios_roles
