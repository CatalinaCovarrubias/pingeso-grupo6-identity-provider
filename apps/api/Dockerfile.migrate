# Imagen que solo aplica las migraciones de PostgreSQL con goose y termina.
FROM golang:1.26.11-alpine3.23@sha256:23f198931d4bd83b4f5a613bd75656257ae8bf832dcbc2db80e1050b5219ca2a AS build
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 go install -trimpath -ldflags="-s -w" github.com/pressly/goose/v3/cmd/goose@v3.24.1

FROM alpine:3.23.7@sha256:ff7f0c727dd796aa36787bfcd9a64bf35a6ce72a73451b3359fde849b6703d63
RUN addgroup -S -g 10001 migrador && adduser -S -u 10001 -G migrador migrador
WORKDIR /app
COPY --from=build /go/bin/goose /usr/local/bin/goose
COPY --chown=10001:10001 apps/api/db/migrations /app/db/migrations
USER 10001:10001
ENTRYPOINT ["sh", "-c", "goose -dir /app/db/migrations postgres \"$DATABASE_URL\" up"]
